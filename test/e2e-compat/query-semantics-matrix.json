      "query": "{app=\"nginx-ingress\",env=\"production\"} !~ \"sqlmap\"",
      "expectation": "success",
      "expect_result_type": "streams",
      "compare": "log_entries",
      "require_non_empty": true
    },
    {
      "id": "json_pipeline_field_filter",
