      "query": "{app=\"api-gateway\",env=\"production\"} | json | method=\"GET\"",
      "expectation": "success",
      "expect_result_type": "streams",
      "compare": "log_entries",
      "require_non_empty": true
    },
    {
      "id": "json_pipeline_numeric_filter",
