{
  "description": "Manifest-driven Loki semantics parity cases. These use real Loki in the compose stack as the oracle for Loki-facing query behavior.",
  "oracle": "docker-compose Loki reference",
  "cases": [
    {
      "id": "selector_exact_instant",
      "family": "selector",
      "endpoint": "query",
      "query": "{app=\"api-gateway\",namespace=\"prod\",level=\"error\",env=\"production\"}",
      "expectation": "client_error"
    },
    {
      "id": "selector_exact_range",
      "family": "selector",
      "endpoint": "query_range",
      "query": "{app=\"api-gateway\",namespace=\"prod\",level=\"error\",env=\"production\"}",
      "expectation": "success",
      "expect_result_type": "streams",
      "compare": "log_entries",
      "require_non_empty": true
    },
    {
      "id": "multi_label_regex_range",
      "family": "selector",
      "endpoint": "query_range",
      "query": "{app=~\"api-gateway\",namespace=\"prod\",env=\"production\"}",
      "expectation": "success",
      "expect_result_type": "streams",
      "compare": "log_entries",
      "require_non_empty": true
    },
    {
      "id": "multi_label_negative_regex",
      "family": "selector",
      "endpoint": "query_range",
      "query": "{app=~\"api-gateway|payment-service\",namespace=\"prod\",env=\"production\"}",
      "expectation": "success",
      "expect_result_type": "streams",
      "compare": "log_entries",
      "require_non_empty": true
    },
    {
      "id": "selector_regex_prefix_is_not_substring",
      "family": "selector",
      "endpoint": "query_range",
      "query": "{app=~\"api\",namespace=\"prod\",env=\"production\"}",
      "expectation": "success",
      "expect_result_type": "streams",
      "compare": "log_entries",
      "require_non_empty": false
    },
    {
      "id": "line_filters_chained",
      "family": "line_filter",
      "endpoint": "query_range",
      "query": "{app=\"api-gateway\",level=\"error\",env=\"production\"} |= \"error\" != \"not found\"",
      "expectation": "success",
      "expect_result_type": "streams",
      "compare": "log_entries",
      "require_non_empty": true
    },
    {
      "id": "line_filters_chain_mixed",
      "family": "line_filter",
      "endpoint": "query_range",
      "query": "{app=\"api-gateway\",env=\"production\"} |= \"api\" |~ \"GET|POST\" != \"health\"",
      "expectation": "success",
      "expect_result_type": "streams",
      "compare": "log_entries",
      "require_non_empty": true
    },
    {
      "id": "line_filters_negative_regex",
      "family": "line_filter",
