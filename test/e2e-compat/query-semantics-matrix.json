      "query": "{app=\"api-gateway\",env=\"production\"} | regexp \"\\\"status\\\":(?P<status>[0-9]+)\" | status=~\"5..\"",
      "expectation": "success",
      "expect_result_type": "streams",
      "compare": "log_entries",
      "require_non_empty": true
    },
    {
