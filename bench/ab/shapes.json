{
 "ranges": {
  "1h": [
   3600,
   5
  ],
  "3h": [
   10800,
   5
  ],
  "6h": [
   21600,
   10
  ],
  "24h": [
   86400,
   60
  ],
  "7d": [
   604800,
   600
  ]
 },
 "sets": {
  "json-filter-pushdown": {
   "description": "| json / | logfmt range metrics with label filters on parsed fields (PR #611). Grafana Explore log volume and Logs Drilldown field breakdowns over a JSON stream.",
   "ranges": [
    "1h",
    "3h",
    "6h",
    "24h"
   ],
   "shapes": [
    {
     "name": "A explore volume, 2 filters, drop",
     "query": "sum by (level, detected_level) (count_over_time({env=\"production\"} | json | service_version=`0.96.0` | pipeline=`logs/loki` | drop __error__ [1m]))",
     "covers": [
      "semantics/json-filter-pushdown-underscore-label",
      "semantics/json-filter-pushdown-translated-label",
      "explore-logs-volume-json",
      "parser-error-and-label-collision",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "B grouped sum, filter, no drop",
     "query": "sum by (level) (count_over_time({env=\"production\"} | json | pipeline=`logs/loki` [1m]))",
     "covers": [
      "semantics/json-filter-pushdown-without-error-drop",
      "parser-error-and-label-collision",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "C ungrouped sum, filter, no drop",
     "query": "sum(count_over_time({env=\"production\"} | json | pipeline=`logs/loki` [1m]))",
     "covers": [
      "semantics/json-filter-pushdown-ungrouped-sum",
      "parser-error-and-label-collision",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "D volume, no filters",
     "query": "sum by (level, detected_level) (count_over_time({env=\"production\"} | json | drop __error__ [1m]))",
     "covers": [
      "explore-logs-volume-json",
      "severity-detected-level-derivation",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "E field breakdown pipeline (explore)",
     "query": "sum by (pipeline) (count_over_time({env=\"production\"} | json | drop __error__ | pipeline!=\"\" [1m]))",
     "covers": [
      "parser-json",
      "parsed-label-series-identity",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "F field breakdown service_version (explore)",
     "query": "sum by (service_version) (count_over_time({env=\"production\"} | json | drop __error__ | service_version!=\"\" [1m]))",
     "covers": [
      "semantics/json-filter-pushdown-underscore-label",
      "semantics/json-label-spelling-probe",
      "parsed-label-series-identity",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "G field breakdown pipeline (drilldown)",
     "query": "sum by (pipeline) (count_over_time({env=\"production\"} | json | drop __error__ | pipeline!=\"\" [$__auto]))",
     "headers": {
      "X-Query-Tags": "Source=grafana-lokiexplore-app"
     },
     "covers": [
      "parser-json",
      "parsed-label-series-identity",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "H field breakdown service_version (drilldown)",
     "query": "sum by (service_version) (count_over_time({env=\"production\"} | json | drop __error__ | service_version!=\"\" [$__auto]))",
     "headers": {
      "X-Query-Tags": "Source=grafana-lokiexplore-app"
     },
     "covers": [
      "semantics/json-filter-pushdown-underscore-label",
      "semantics/json-label-spelling-probe",
      "parsed-label-series-identity",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "I grafana volume of B",
     "query": "sum by (level, detected_level) (count_over_time({env=\"production\"} | json | pipeline=`logs/loki` | drop __error__ [1m]))",
     "covers": [
      "semantics/json-filter-pushdown-without-error-drop",
      "explore-logs-volume-json",
      "loki_api_v1_query_range"
     ]
    }
   ]
  },
  "control": {
   "description": "Shapes a change must not slow down or alter. Run on every performance-relevant PR.",
   "ranges": [
    "1h",
    "24h"
   ],
   "shapes": [
    {
     "name": "logs plain",
     "query": "{env=\"production\"}",
     "logs": true,
     "covers": [
      "loki_api_v1_query_range"
     ],
     "smoke": true
    },
    {
     "name": "logs | json",
     "query": "{env=\"production\"} | json",
     "logs": true,
     "covers": [
      "parser-json",
      "loki_api_v1_query_range"
     ],
     "smoke": true
    },
    {
     "name": "logs | logfmt",
     "query": "{env=\"production\"} | logfmt",
     "logs": true,
     "covers": [
      "parser-logfmt",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "json volume no filters",
     "query": "sum by (level, detected_level) (count_over_time({env=\"production\"} | json | drop __error__ [1m]))",
     "covers": [
      "explore-logs-volume-json",
      "severity-detected-level-derivation",
      "loki_api_v1_query_range"
     ],
     "smoke": true
    },
    {
     "name": "logfmt volume",
     "query": "sum by (level, detected_level) (count_over_time({env=\"production\"} | logfmt | drop __error__ [1m]))",
     "covers": [
      "parser-logfmt",
      "severity-detected-level-derivation",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "plain volume",
     "query": "sum by (level, detected_level) (count_over_time({env=\"production\"} | drop __error__ [1m]))",
     "covers": [
      "severity-detected-level-derivation",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "stream-label count by app",
     "query": "sum by (app) (count_over_time({env=\"production\"}[1m]))",
     "covers": [
      "range_function-count-over-time",
      "operator-sum",
      "metric-series-identity",
      "loki_api_v1_query_range"
     ],
     "smoke": true
    },
    {
     "name": "ungrouped rate",
     "query": "sum(rate({env=\"production\"}[5m]))",
     "covers": [
      "range_function-rate",
      "operator-sum",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "bytes_over_time by app",
     "query": "sum by (app) (bytes_over_time({env=\"production\"}[5m]))",
     "covers": [
      "range_function-bytes-over-time",
      "operator-sum",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "topk rate by app",
     "query": "topk(5, sum by (app) (rate({env=\"production\"}[5m])))",
     "covers": [
      "operator-topk",
      "range_function-rate",
      "loki_api_v1_query_range"
     ],
     "smoke": true
    },
    {
     "name": "detected_level volume",
     "query": "sum by (detected_level) (count_over_time({env=\"production\"} | drop __error__ [1m]))",
     "covers": [
      "severity-detected-level-derivation",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "by service_name",
     "query": "sum by (service_name) (count_over_time({env=\"production\"}[1m]))",
     "covers": [
      "service-name-derivation",
      "drilldown-service-landing",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "drilldown level volume",
     "query": "sum by (level) (count_over_time({env=\"production\"}[$__auto]))",
     "headers": {
      "X-Query-Tags": "Source=grafana-lokiexplore-app"
     },
     "covers": [
      "severity-detected-level-derivation",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "drilldown service landing",
     "query": "sum by (service_name) (count_over_time({env=\"production\"}[$__auto]))",
     "headers": {
      "X-Query-Tags": "Source=grafana-lokiexplore-app"
     },
     "covers": [
      "drilldown-service-landing",
      "service-name-derivation",
      "loki_api_v1_query_range"
     ],
     "smoke": true
    },
    {
     "name": "drilldown detected_level",
     "query": "sum by (detected_level) (count_over_time({env=\"production\"}[$__auto]))",
     "headers": {
      "X-Query-Tags": "Source=grafana-lokiexplore-app"
     },
     "covers": [
      "severity-detected-level-derivation",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "json rate by level (no filter, no drop)",
     "query": "sum by (level) (rate({env=\"production\"} | json [5m]))",
     "covers": [
      "parser-json",
      "parser-error-and-label-collision",
      "loki_api_v1_query_range"
     ],
     "smoke": true
    },
    {
     "name": "logfmt count by level, filter, drop",
     "query": "sum by (level) (count_over_time({env=\"production\"} | logfmt | level=`info` | drop __error__ [1m]))",
     "covers": [
      "parser-logfmt",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "instant ungrouped rate",
     "query": "sum(rate({env=\"production\"}[5m]))",
     "instant": true,
     "covers": [
      "range_function-rate",
      "loki_api_v1_query"
     ],
     "smoke": true
    },
    {
     "name": "instant json volume",
     "query": "sum by (level, detected_level) (count_over_time({env=\"production\"} | json | drop __error__ [5m]))",
     "instant": true,
     "covers": [
      "explore-logs-volume-json",
      "loki_api_v1_query"
     ]
    },
    {
     "name": "instant json filtered",
     "query": "sum by (level) (count_over_time({env=\"production\"} | json | pipeline=`logs/loki` [5m]))",
     "instant": true,
     "covers": [
      "semantics/json-filter-pushdown-without-error-drop",
      "loki_api_v1_query"
     ]
    }
   ]
  },
  "metric-latency-gap": {
   "description": "Shapes the metric latency work targets: the parse-risk probes of the | json stats pushdown (breakdowns and volumes by underscore labels), label filters before the parser (Logs Drilldown pages with a level filter selected) and Explore volumes with a level filter. Run with the json-filter-pushdown set.",
   "ranges": [
    "1h",
    "3h",
    "6h",
    "24h"
   ],
   "shapes": [
    {
     "name": "DL6 explore volume, level filter before json",
     "query": "sum by (level, detected_level) (count_over_time({env=\"production\"} | detected_level=\"info\" | json | drop __error__ [1m]))",
     "covers": [
      "semantics/label-filter-before-parser-pushdown",
      "explore-logs-volume-json",
      "severity-detected-level-derivation",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "DL2 drilldown field breakdown, level + stream-label filter before json",
     "query": "sum by (export_ms) (count_over_time({env=\"production\", namespace=\"monitoring\"} | detected_level=\"info\" | json | drop __error__, __error_details__ | export_ms!=\"\" | pipeline=\"logs/loki\" [$__auto]))",
     "headers": {
      "X-Query-Tags": "Source=grafana-lokiexplore-app"
     },
     "covers": [
      "semantics/label-filter-before-parser-pushdown",
      "severity-detected-level-derivation",
      "parsed-label-series-identity",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "DL1 drilldown field breakdown json-expr, level filter",
     "query": "sum by (event) (count_over_time({env=\"production\"} | detected_level=\"info\" | json event=\"[\\\"event\\\"]\" | drop __error__, __error_details__ | event!=\"\" [$__auto]))",
     "headers": {
      "X-Query-Tags": "Source=grafana-lokiexplore-app"
     },
     "covers": [
      "severity-detected-level-derivation",
      "parser-json",
      "parsed-label-series-identity",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "DL3 drilldown logfmt field breakdown, level filter",
     "query": "sum by (job_id) (count_over_time({env=\"production\"} | detected_level=\"info\" | logfmt | job_id!=\"\" [$__auto]))",
     "headers": {
      "X-Query-Tags": "Source=grafana-lokiexplore-app"
     },
     "covers": [
      "severity-detected-level-derivation",
      "parser-logfmt",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "DL4 instant count, level filter, json+logfmt, 1h",
     "query": "sum(count_over_time({env=\"production\"} | detected_level=\"info\" | json | logfmt | drop __error__, __error_details__ [1h]))",
     "instant": true,
     "covers": [
      "severity-detected-level-derivation",
      "parser-json",
      "parser-logfmt",
      "loki_api_v1_query"
     ]
    }
   ]
  }
 }
}
