{
 "ranges": {
  "1h": [
   3600,
   5
  ],
  "3h": [
   10800,
   5
  ],
  "6h": [
   21600,
   10
  ],
  "24h": [
   86400,
   60
  ],
  "7d": [
   604800,
   600
  ]
 },
 "sets": {
  "json-filter-pushdown": {
   "description": "| json / | logfmt range metrics with label filters on parsed fields (PR #611). Grafana Explore log volume and Logs Drilldown field breakdowns over a JSON stream.",
   "ranges": [
    "1h",
    "3h",
    "6h",
    "24h"
   ],
   "shapes": [
    {
     "name": "A explore volume, 2 filters, drop",
     "query": "sum by (level, detected_level) (count_over_time({env=\"production\"} | json | service_version=`0.96.0` | pipeline=`logs/loki` | drop __error__ [1m]))",
     "covers": [
      "semantics/json-filter-pushdown-underscore-label",
      "semantics/json-filter-pushdown-translated-label",
      "explore-logs-volume-json",
      "parser-error-and-label-collision",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "B grouped sum, filter, no drop",
     "query": "sum by (level) (count_over_time({env=\"production\"} | json | pipeline=`logs/loki` [1m]))",
     "covers": [
      "semantics/json-filter-pushdown-without-error-drop",
      "parser-error-and-label-collision",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "C ungrouped sum, filter, no drop",
     "query": "sum(count_over_time({env=\"production\"} | json | pipeline=`logs/loki` [1m]))",
     "covers": [
      "semantics/json-filter-pushdown-ungrouped-sum",
      "parser-error-and-label-collision",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "D volume, no filters",
     "query": "sum by (level, detected_level) (count_over_time({env=\"production\"} | json | drop __error__ [1m]))",
     "covers": [
      "explore-logs-volume-json",
      "severity-detected-level-derivation",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "E field breakdown pipeline (explore)",
     "query": "sum by (pipeline) (count_over_time({env=\"production\"} | json | drop __error__ | pipeline!=\"\" [1m]))",
     "covers": [
      "parser-json",
      "parsed-label-series-identity",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "F field breakdown service_version (explore)",
     "query": "sum by (service_version) (count_over_time({env=\"production\"} | json | drop __error__ | service_version!=\"\" [1m]))",
     "covers": [
      "semantics/json-filter-pushdown-underscore-label",
      "semantics/json-label-spelling-probe",
      "parsed-label-series-identity",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "G field breakdown pipeline (drilldown)",
     "query": "sum by (pipeline) (count_over_time({env=\"production\"} | json | drop __error__ | pipeline!=\"\" [$__auto]))",
     "headers": {
      "X-Query-Tags": "Source=grafana-lokiexplore-app"
     },
     "covers": [
      "parser-json",
      "parsed-label-series-identity",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "H field breakdown service_version (drilldown)",
     "query": "sum by (service_version) (count_over_time({env=\"production\"} | json | drop __error__ | service_version!=\"\" [$__auto]))",
     "headers": {
      "X-Query-Tags": "Source=grafana-lokiexplore-app"
     },
     "covers": [
      "semantics/json-filter-pushdown-underscore-label",
      "semantics/json-label-spelling-probe",
      "parsed-label-series-identity",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "I grafana volume of B",
     "query": "sum by (level, detected_level) (count_over_time({env=\"production\"} | json | pipeline=`logs/loki` | drop __error__ [1m]))",
     "covers": [
      "semantics/json-filter-pushdown-without-error-drop",
      "explore-logs-volume-json",
      "loki_api_v1_query_range"
     ]
    }
   ]
  },
  "control": {
   "description": "Shapes a change must not slow down or alter. Run on every performance-relevant PR.",
   "ranges": [
    "1h",
    "24h"
   ],
   "shapes": [
    {
     "name": "logs plain",
     "query": "{env=\"production\"}",
     "logs": true,
     "covers": [
      "loki_api_v1_query_range"
     ],
     "smoke": true
    },
    {
     "name": "logs | json",
     "query": "{env=\"production\"} | json",
     "logs": true,
     "covers": [
      "parser-json",
      "loki_api_v1_query_range"
     ],
     "smoke": true
    },
    {
     "name": "logs | logfmt",
     "query": "{env=\"production\"} | logfmt",
     "logs": true,
     "covers": [
      "parser-logfmt",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "json volume no filters",
     "query": "sum by (level, detected_level) (count_over_time({env=\"production\"} | json | drop __error__ [1m]))",
     "covers": [
      "explore-logs-volume-json",
      "severity-detected-level-derivation",
      "loki_api_v1_query_range"
     ],
     "smoke": true
    },
    {
     "name": "logfmt volume",
     "query": "sum by (level, detected_level) (count_over_time({env=\"production\"} | logfmt | drop __error__ [1m]))",
     "covers": [
      "parser-logfmt",
      "severity-detected-level-derivation",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "plain volume",
     "query": "sum by (level, detected_level) (count_over_time({env=\"production\"} | drop __error__ [1m]))",
     "covers": [
      "severity-detected-level-derivation",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "stream-label count by app",
     "query": "sum by (app) (count_over_time({env=\"production\"}[1m]))",
     "covers": [
      "range_function-count-over-time",
      "operator-sum",
      "metric-series-identity",
      "loki_api_v1_query_range"
     ],
     "smoke": true
    },
    {
     "name": "ungrouped rate",
     "query": "sum(rate({env=\"production\"}[5m]))",
     "covers": [
      "range_function-rate",
      "operator-sum",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "bytes_over_time by app",
     "query": "sum by (app) (bytes_over_time({env=\"production\"}[5m]))",
     "covers": [
      "range_function-bytes-over-time",
      "operator-sum",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "topk rate by app",
     "query": "topk(5, sum by (app) (rate({env=\"production\"}[5m])))",
     "covers": [
      "operator-topk",
      "range_function-rate",
      "loki_api_v1_query_range"
     ],
     "smoke": true
    },
    {
     "name": "detected_level volume",
     "query": "sum by (detected_level) (count_over_time({env=\"production\"} | drop __error__ [1m]))",
     "covers": [
      "severity-detected-level-derivation",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "by service_name",
     "query": "sum by (service_name) (count_over_time({env=\"production\"}[1m]))",
     "covers": [
      "service-name-derivation",
      "drilldown-service-landing",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "drilldown level volume",
     "query": "sum by (level) (count_over_time({env=\"production\"}[$__auto]))",
     "headers": {
      "X-Query-Tags": "Source=grafana-lokiexplore-app"
     },
     "covers": [
      "severity-detected-level-derivation",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "drilldown service landing",
     "query": "sum by (service_name) (count_over_time({env=\"production\"}[$__auto]))",
     "headers": {
      "X-Query-Tags": "Source=grafana-lokiexplore-app"
     },
     "covers": [
      "drilldown-service-landing",
      "service-name-derivation",
      "loki_api_v1_query_range"
     ],
     "smoke": true
    },
    {
     "name": "drilldown detected_level",
     "query": "sum by (detected_level) (count_over_time({env=\"production\"}[$__auto]))",
     "headers": {
      "X-Query-Tags": "Source=grafana-lokiexplore-app"
     },
     "covers": [
      "severity-detected-level-derivation",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "json rate by level (no filter, no drop)",
     "query": "sum by (level) (rate({env=\"production\"} | json [5m]))",
     "covers": [
      "parser-json",
      "parser-error-and-label-collision",
      "loki_api_v1_query_range"
     ],
     "smoke": true
    },
    {
     "name": "logfmt count by level, filter, drop",
     "query": "sum by (level) (count_over_time({env=\"production\"} | logfmt | level=`info` | drop __error__ [1m]))",
     "covers": [
      "parser-logfmt",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "instant ungrouped rate",
     "query": "sum(rate({env=\"production\"}[5m]))",
     "instant": true,
     "covers": [
      "range_function-rate",
      "loki_api_v1_query"
     ],
     "smoke": true
    },
    {
     "name": "instant json volume",
     "query": "sum by (level, detected_level) (count_over_time({env=\"production\"} | json | drop __error__ [5m]))",
     "instant": true,
     "covers": [
      "explore-logs-volume-json",
      "loki_api_v1_query"
     ]
    },
    {
     "name": "instant json filtered",
     "query": "sum by (level) (count_over_time({env=\"production\"} | json | pipeline=`logs/loki` [5m]))",
     "instant": true,
     "covers": [
      "semantics/json-filter-pushdown-without-error-drop",
      "loki_api_v1_query"
     ]
    }
   ]
  },
  "metric-latency-gap": {
   "description": "Shapes the metric latency work targets: the parse-risk probes of the | json stats pushdown (breakdowns and volumes by underscore labels), label filters before the parser (Logs Drilldown pages with a level filter selected) and Explore volumes with a level filter. Run with the json-filter-pushdown set.",
   "ranges": [
    "1h",
    "3h",
    "6h",
    "24h"
   ],
   "shapes": [
    {
     "name": "DL6 explore volume, level filter before json",
     "query": "sum by (level, detected_level) (count_over_time({env=\"production\"} | detected_level=\"info\" | json | drop __error__ [1m]))",
     "covers": [
      "semantics/label-filter-before-parser-pushdown",
      "explore-logs-volume-json",
      "severity-detected-level-derivation",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "DL2 drilldown field breakdown, level + stream-label filter before json",
     "query": "sum by (export_ms) (count_over_time({env=\"production\", namespace=\"monitoring\"} | detected_level=\"info\" | json | drop __error__, __error_details__ | export_ms!=\"\" | pipeline=\"logs/loki\" [$__auto]))",
     "headers": {
      "X-Query-Tags": "Source=grafana-lokiexplore-app"
     },
     "covers": [
      "semantics/label-filter-before-parser-pushdown",
      "severity-detected-level-derivation",
      "parsed-label-series-identity",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "DL1 drilldown field breakdown json-expr, level filter",
     "query": "sum by (event) (count_over_time({env=\"production\"} | detected_level=\"info\" | json event=\"[\\\"event\\\"]\" | drop __error__, __error_details__ | event!=\"\" [$__auto]))",
     "headers": {
      "X-Query-Tags": "Source=grafana-lokiexplore-app"
     },
     "covers": [
      "severity-detected-level-derivation",
      "parser-json",
      "parsed-label-series-identity",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "DL3 drilldown logfmt field breakdown, level filter",
     "query": "sum by (job_id) (count_over_time({env=\"production\"} | detected_level=\"info\" | logfmt | job_id!=\"\" [$__auto]))",
     "headers": {
      "X-Query-Tags": "Source=grafana-lokiexplore-app"
     },
     "covers": [
      "severity-detected-level-derivation",
      "parser-logfmt",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "DL4 instant count, level filter, json+logfmt, 1h",
     "query": "sum(count_over_time({env=\"production\"} | detected_level=\"info\" | json | logfmt | drop __error__, __error_details__ [1h]))",
     "instant": true,
     "covers": [
      "severity-detected-level-derivation",
      "parser-json",
      "parser-logfmt",
      "loki_api_v1_query"
     ]
    }
   ]
  },
  "drilldown-breakdown-exact": {
   "description": "Logs Drilldown label and field breakdowns as the plugin sends them, answered exactly (every series up to the tenant's max_query_series, the busiest with Loki's warning over it) instead of from sampled /hits top values. High-cardinality labels and fields (pod, user_id, batch_id) and a low-cardinality one (namespace).",
   "ranges": [
    "1h",
    "6h",
    "24h",
    "7d"
   ],
   "shapes": [
    {
     "name": "DB1 label breakdown pod",
     "query": "sum(count_over_time({env=\"production\" ,pod != \"\"} [$__auto])) by (pod)",
     "headers": {
      "X-Query-Tags": "Source=grafana-lokiexplore-app"
     },
     "covers": [
      "limits/drilldown-breakdown-exact",
      "series-limits-and-partial-results",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "DB2 label breakdown namespace",
     "query": "sum(count_over_time({env=\"production\" ,namespace != \"\"} [$__auto])) by (namespace)",
     "headers": {
      "X-Query-Tags": "Source=grafana-lokiexplore-app"
     },
     "covers": [
      "limits/drilldown-breakdown-exact",
      "series-limits-and-partial-results",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "DB3 json field breakdown user_id",
     "query": "sum by (user_id) (count_over_time({env=\"production\"} | json user_id=\"[\\\"user_id\\\"]\" | drop __error__, __error_details__ | user_id!=\"\" [$__auto]))",
     "headers": {
      "X-Query-Tags": "Source=grafana-lokiexplore-app"
     },
     "covers": [
      "limits/drilldown-breakdown-exact",
      "series-limits-and-partial-results",
      "loki_api_v1_query_range",
      "parser-json"
     ]
    },
    {
     "name": "DB4 json field breakdown batch_id",
     "query": "sum by (batch_id) (count_over_time({env=\"production\"} | json batch_id=\"[\\\"batch_id\\\"]\" | drop __error__, __error_details__ | batch_id!=\"\" [$__auto]))",
     "headers": {
      "X-Query-Tags": "Source=grafana-lokiexplore-app"
     },
     "covers": [
      "limits/drilldown-breakdown-exact",
      "series-limits-and-partial-results",
      "loki_api_v1_query_range",
      "parser-json"
     ]
    }
   ]
  },
  "metadata-inventory": {
   "description": "Label, field and volume inventory calls Explore's label browser and Logs Drilldown make over 1h-7d. The metadata inventory answers them from time buckets; the refresh shapes move the window past the response cache's time bucket on every run (5 min up to 6h, 1h up to 48h, 6h beyond, plus 17 s), which is what a Grafana refresh does once per bucket, so runs after the first measure a shifted window",
   "ranges": [
    "1h",
    "6h",
    "24h",
    "7d"
   ],
   "shapes": [
    {
     "name": "explore labels (label browser)",
     "path": "/loki/api/v1/labels",
     "covers": [
      "loki_api_v1_labels",
      "semantics/label-browser-latency-cold-and-refresh",
      "semantics/label-inventory-exact-and-incremental",
      "limits/concurrent-full-retention-scans-exhaust-backend",
      "limits/metadata-scan-queue-429",
      "backend-admission-and-heavy-query-queueing"
     ]
    },
    {
     "name": "explore labels with selector",
     "path": "/loki/api/v1/labels",
     "query": "{env=\"production\"}",
     "covers": [
      "loki_api_v1_labels",
      "semantics/label-browser-latency-cold-and-refresh",
      "semantics/label-inventory-exact-and-incremental",
      "limits/concurrent-full-retention-scans-exhaust-backend",
      "limits/metadata-scan-queue-429",
      "backend-admission-and-heavy-query-queueing"
     ]
    },
    {
     "name": "explore label values env",
     "path": "/loki/api/v1/label/env/values",
     "covers": [
      "loki_api_v1_label_name_values",
      "semantics/label-browser-latency-cold-and-refresh",
      "semantics/label-inventory-exact-and-incremental",
      "limits/concurrent-full-retention-scans-exhaust-backend",
      "limits/metadata-scan-queue-429",
      "backend-admission-and-heavy-query-queueing"
     ]
    },
    {
     "name": "explore label values service_name",
     "path": "/loki/api/v1/label/service_name/values",
     "query": "{env=\"production\"}",
     "covers": [
      "loki_api_v1_label_name_values",
      "semantics/label-browser-latency-cold-and-refresh",
      "semantics/label-inventory-exact-and-incremental",
      "limits/concurrent-full-retention-scans-exhaust-backend",
      "limits/metadata-scan-queue-429",
      "backend-admission-and-heavy-query-queueing"
     ]
    },
    {
     "name": "drilldown landing volume",
     "path": "/loki/api/v1/index/volume",
     "query": "{service_name=~\".+\"}",
     "params": {
      "limit": "5000"
     },
     "headers": {
      "X-Query-Tags": "Source=grafana-lokiexplore-app",
      "User-Agent": "Grafana/13.2.1"
     },
     "covers": [
      "loki_api_v1_index_volume",
      "backend-admission-and-heavy-query-queueing"
     ]
    },
    {
     "name": "drilldown detected labels",
     "path": "/loki/api/v1/detected_labels",
     "query": "{service_name=\"api-gateway\"}",
     "headers": {
      "X-Query-Tags": "Source=grafana-lokiexplore-app",
      "User-Agent": "Grafana/13.2.1"
     },
     "covers": [
      "loki_api_v1_detected_labels",
      "backend-admission-and-heavy-query-queueing"
     ]
    },
    {
     "name": "drilldown detected fields",
     "path": "/loki/api/v1/detected_fields",
     "query": "{service_name=\"api-gateway\"}",
     "params": {
      "limit": "1000"
     },
     "headers": {
      "X-Query-Tags": "Source=grafana-lokiexplore-app",
      "User-Agent": "Grafana/13.2.1"
     },
     "covers": [
      "loki_api_v1_detected_fields",
      "backend-admission-and-heavy-query-queueing"
     ]
    },
    {
     "name": "refresh labels (label browser)",
     "path": "/loki/api/v1/labels",
     "shift": {
      "1h": 317,
      "6h": 317,
      "24h": 3617,
      "7d": 21617
     },
     "covers": [
      "loki_api_v1_labels",
      "semantics/label-browser-latency-cold-and-refresh",
      "semantics/label-inventory-exact-and-incremental",
      "limits/concurrent-full-retention-scans-exhaust-backend",
      "limits/metadata-scan-adaptive-limit"
     ]
    },
    {
     "name": "refresh labels with selector",
     "path": "/loki/api/v1/labels",
     "query": "{env=\"production\"}",
     "shift": {
      "1h": 317,
      "6h": 317,
      "24h": 3617,
      "7d": 21617
     },
     "covers": [
      "loki_api_v1_labels",
      "semantics/label-browser-latency-cold-and-refresh",
      "semantics/label-inventory-exact-and-incremental",
      "limits/concurrent-full-retention-scans-exhaust-backend",
      "limits/metadata-scan-adaptive-limit"
     ]
    },
    {
     "name": "refresh label values env",
     "path": "/loki/api/v1/label/env/values",
     "shift": {
      "1h": 317,
      "6h": 317,
      "24h": 3617,
      "7d": 21617
     },
     "covers": [
      "loki_api_v1_label_name_values",
      "semantics/label-browser-latency-cold-and-refresh",
      "semantics/label-inventory-exact-and-incremental",
      "limits/concurrent-full-retention-scans-exhaust-backend",
      "limits/metadata-scan-adaptive-limit"
     ]
    },
    {
     "name": "refresh label values service_name",
     "path": "/loki/api/v1/label/service_name/values",
     "query": "{env=\"production\"}",
     "shift": {
      "1h": 317,
      "6h": 317,
      "24h": 3617,
      "7d": 21617
     },
     "covers": [
      "loki_api_v1_label_name_values",
      "semantics/label-browser-latency-cold-and-refresh",
      "semantics/label-inventory-exact-and-incremental",
      "limits/concurrent-full-retention-scans-exhaust-backend",
      "limits/metadata-scan-adaptive-limit"
     ]
    }
   ]
  },
  "loki-profile-otel-metadata": {
   "description": "OTel structured-metadata filters in the Loki-compatible profile: the underscore spelling Loki accepts (log query and the Explore log volume, pushed down to VictoriaLogs stats) and the dotted spelling Loki rejects with a parse error (the proxy used to run it on the raw-row path). Run with the control set.",
   "ranges": [
    "1h",
    "3h",
    "6h",
    "24h"
   ],
   "shapes": [
    {
     "name": "O1 explore logs, underscore structured-metadata filter",
     "query": "{env=\"production\"} | json | pipeline=`metrics/prometheus` | k8s_namespace_name=`monitoring`",
     "covers": [
      "profiles/structured-metadata-keys-per-profile",
      "loki-compatible-profile",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "O2 explore log volume (Grafana form), underscore structured-metadata filter",
     "query": "sum by (level, detected_level) (count_over_time({env=\"production\"} | json | pipeline=`metrics/prometheus` | k8s_namespace_name=`monitoring` | drop __error__ [1m]))",
     "covers": [
      "profiles/structured-metadata-keys-per-profile",
      "loki-compatible-profile",
      "explore-logs-volume-json",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "O3 explore logs, dotted structured-metadata filter",
     "query": "{env=\"production\"} | json | pipeline=`metrics/prometheus` | k8s.namespace.name=`monitoring`",
     "covers": [
      "profiles/dotted-name-parse-error",
      "loki-compatible-profile",
      "loki_api_v1_query_range"
     ]
    },
    {
     "name": "O4 explore log volume (Grafana form), dotted structured-metadata filter",
     "query": "sum by (level, detected_level) (count_over_time({env=\"production\"} | json | pipeline=`metrics/prometheus` | k8s.namespace.name=`monitoring` | drop __error__ [1m]))",
