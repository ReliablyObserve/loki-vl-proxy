  "metadata-freshness": {
   "description": "Label and label-value listings that end now, which Loki answers live (its results cache holds only splits older than max_metadata_cache_freshness, 24h): the proxy refetches a cached answer older than the recent-tail max-staleness instead of serving it for up to an hour. The historical controls end two days ago and must not change: their answers stay cached.. Runs are 3 s apart (\"pause\"), longer than the recent-tail max staleness, so each run after the first meets an aged cache entry and times the refetch.",
   "ranges": [
    "1h",
    "6h",
    "24h",
    "7d"
   ],
   "shapes": [
    {
     "name": "labels ending now",
     "path": "/loki/api/v1/labels",
     "covers": [
      "loki_api_v1_labels",
      "semantics/metadata-answers-include-last-24h-like-loki",
      "semantics/label-inventory-exact-and-incremental",
      "data-probing-and-freshness"
     ],
     "pause": 3
    },
    {
     "name": "label values env ending now",
     "path": "/loki/api/v1/label/env/values",
     "covers": [
      "loki_api_v1_label_name_values",
      "semantics/metadata-answers-include-last-24h-like-loki",
      "semantics/label-inventory-exact-and-incremental",
      "data-probing-and-freshness"
     ],
     "pause": 3
    },
    {
     "name": "labels ending two days ago (control)",
     "path": "/loki/api/v1/labels",
     "covers": [
      "loki_api_v1_labels",
      "semantics/metadata-answers-include-last-24h-like-loki",
      "semantics/label-inventory-exact-and-incremental",
      "data-probing-and-freshness"
     ],
     "end_offset": 172800,
     "pause": 3
    },
    {
     "name": "label values env ending two days ago (control)",
     "path": "/loki/api/v1/label/env/values",
     "covers": [
      "loki_api_v1_label_name_values",
      "semantics/metadata-answers-include-last-24h-like-loki",
      "semantics/label-inventory-exact-and-incremental",
      "data-probing-and-freshness"
     ],
     "end_offset": 172800,
     "pause": 3
    }
   ]
  },
  "stage-field-exposure": {
   "description": "Log queries whose stages expose part of a JSON or logfmt line (json and logfmt extraction lists, line_format, regexp, label_format rename) and label filters on line keys and structured metadata, classified per row in the Loki-compatible profile; metric shapes over the same stages, whose LogsQL changes only for a label_format rename. Run with the control set.",
   "ranges": [
    "1h",
    "3h",
    "6h",
    "24h"
   ],
   "shapes": [
