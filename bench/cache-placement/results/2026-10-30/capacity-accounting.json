  "accounting_contracts": {
    "main_7c59fafa": {
      "source_file": "internal/cache/disk.go",
      "source_lines": "236-290",
      "initial_transaction_charge": "b.Stats().LeafInuse, sampled once before pending map iteration, minus key+value bytes reclaimed by expiry sweep",
      "incremental_new_entry_charge": "gzip(expiry[8]+value) bytes only; new key and leaf-entry header are not incrementally charged",
      "overflow_behavior": "Reject candidate; retained records that already exceed the next transaction LeafInuse cap are not evicted.",
      "inline_caveat": "bbolt reports inlined leaf bytes separately from LeafInuse."
    },
    "foundation_and_placement": {
      "source_files": [
        "internal/cache/disk_batch.go",
        "internal/cache/disk_lru.go"
      ],
      "incremental_entry_charge": "len(key)+len(self-describing encoded record), updating planned count/index/bytes for every admission or replacement",
      "overflow_behavior": "Evict LRU records until planned logical key+record bytes, entry count and index budgets fit."
    },
    "bbolt_leaf_inuse": "For these non-inline, sub-bucket-free snapshots: key bytes + record bytes + 16*key count + 16*leaf page count. Physical file length is a separate high-water measure."
  },
  "codec_counterfactual": {
    "method": "Read the actual stored record and expiry without mutating the DB, decode payload, recompress the identical expiry[8]+payload with the legacy klauspost gzip writer and recompress payload with s2.Encode using native adaptive raw fallback and 24-byte header. Report encoded lengths only; no policy change or additional proxy workload.",
    "legacy_roundtrip_verified": "For all three old-main DBs, recomputed legacy gzip byte totals exactly equal actual stored encoded-record byte totals.",
    "limitations": [
      "Retained inventories describe the end of each historical probe; they do not identify which final keys were responsible for a particular query-phase backend call.",
      "Re-encoding measures record size on identical keys and values; it does not measure cache hit rate, latency, CPU, physical disk writes or compression working memory.",
      "Old and new phases used the same numeric cap but did not retain the same effective key+record capacity. The inventory alone does not quantify how much of the backend-call gap this causes."
    ]
  },
  "reproduction": {
    "approach": [
      "Verify report SHA-256, its source ref, and the SHA-256 of its source-label executable against the original manifest.",
      "With proxy processes stopped, verify each database SHA-256; open bbolt read-only with a finite lock timeout.",
      "Visit only cache and cache_records_v1 buckets, sum len(key), len(value), key count, and Bucket.Stats LeafInuse/LeafPageN/InlineBucketInuse.",
      "Decode each value by its bucket format and re-encode identical payload/expiry under legacy gzip and native S2 to compare encoded lengths.",
      "Rehash each database after inspection to verify no mutation."
    ],
    "raw_keys_published": false,
    "inspector_implementation": "Local Go inspector uses existing go.etcd.io/bbolt, klauspost/compress/gzip and klauspost/compress/s2 dependencies; no added dependencies."
  },
  "snapshot_time_limit": "Snapshots were inspected after the historical workloads had completed. Their TTLs may be expired at inspection; retained record inventory does not prove that a record was live, hit, or used by any measured query phase."
