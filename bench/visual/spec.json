{
 "profile": "drilldown+explore",
 "description": "Explore (filtered json log view + volume, json-filter-pushdown metric shapes, logfmt metric, label browser) and Logs Drilldown (landing, service logs, labels, fields, field value breakdown, patterns). Query shapes come from bench/ab/shapes.json set json-filter-pushdown, with [1m] replaced by $__auto as Explore sends it. Entries with core:true form the small always-on set bench/visual/plan.py runs on every relevant PR (core_range only); the others run at ci_ranges when the PR touches code their covers (registry ids, as in bench/ab/shapes.json) point at. An entry's `fixes` lists the registry case ids (conformance/registry/cases, gap block) whose fix it reproduces: a PR that adds a case or turns one to fixed captures those entries at ci_ranges first and never trims them (bench/visual/README.md).",
 "datasources": [
  {
   "id": "main",
   "uid": "vp-main"
  },
  {
   "id": "pr",
   "uid": "vp-pr"
  },
  {
   "id": "loki",
   "uid": "vp-loki"
  }
 ],
 "ranges": {
  "5m": 300,
  "15m": 900,
  "1h": 3600,
  "6h": 21600,
  "24h": 86400,
  "7d": 604800,
  "live": 300
 },
 "default_ranges": [
  "5m",
  "15m",
  "1h",
  "6h",
  "24h",
  "7d"
 ],
 "vars": {
  "service": "otel-collector"
 },
 "pages": [
  {
   "id": "explore-logs-plain",
   "kind": "explore",
   "query": "{env=\"production\"}",
   "covers": [
    "severity-detected-level-derivation",
    "loki_api_v1_query_range"
   ],
   "core": true
  },
  {
   "id": "explore-metric-plain",
   "kind": "explore",
   "query": "sum by (app) (count_over_time({env=\"production\"}[$__auto]))",
   "covers": [
    "range_function-count-over-time",
    "operator-sum",
    "metric-series-identity",
    "loki_api_v1_query_range"
   ],
   "core": true
  },
  {
   "id": "lvl-dd-logs-pill-json",
   "kind": "drilldown",
   "path": "service/{service}/logs",
   "service": true,
   "serviceName": "api-gateway",
   "levels": "detected_level|=|error",
   "ranges": [
    "1h"
   ],
   "covers": [
    "severity-detected-level-derivation",
    "severity/detected-level-filter-json-level",
    "drilldown-service-landing",
    "loki_api_v1_query_range"
   ]
  },
  {
   "id": "lvl-dd-logs-pill-otel",
   "kind": "drilldown",
   "path": "service/{service}/logs",
   "service": true,
   "levels": "detected_level|=|warn",
   "ranges": [
    "1h"
   ],
   "covers": [
    "severity-detected-level-derivation",
    "severity/detected-level-filter-json-level",
    "drilldown-service-landing",
    "loki_api_v1_query_range"
   ]
  },
